DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flou_dev"
JWT_SECRET="generate-with-openssl-rand-hex-32"
COOKIE_SECRET="generate-with-openssl-rand-hex-32"
PORT=3001
NODE_ENV=development

# 64-char hex string (32 bytes). Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# or: openssl rand -hex 32
# REQUIRED — the server refuses to start if this is missing when handling credentials/passwords.
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32-then-double-check-64-chars"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
