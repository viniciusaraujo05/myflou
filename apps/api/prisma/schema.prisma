generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String?
  googleId             String?        @unique
  password             String?
  failedLoginAttempts  Int            @default(0)
  lockedUntil          DateTime?
  statuses             Json           @default("[]")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  refreshTokens        RefreshToken[]
  spaces               Space[]
  milestones           Milestone[]
  inboxItems           InboxItem[]
  timeSessions         TimeSession[]
  tasks                Task[]
  folders              Folder[]
  notes                Note[]
  linkCategories       LinkCategory[]
  links                Link[]
  credentials          Credential[]
  transactions         Transaction[]
  subscriptions        Subscription[]

  @@map("users")
}

model Space {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  color         String         @default("#6366f1")
  icon          String?
  order         Int            @default(0)
  archived      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tasks         Task[]
  milestones    Milestone[]
  timeSessions  TimeSession[]
  folders       Folder[]
  notes         Note[]
  linkCategories LinkCategory[]
  links         Link[]
  credentials   Credential[]
  transactions  Transaction[]
  subscriptions Subscription[]

  @@index([userId])
  @@map("spaces")
}

model RefreshToken {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  tokenPrefix       String   @default("")
  family            String   @default(cuid())
  rotated           Boolean  @default(false)
  rotatedAt         DateTime?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([tokenPrefix])
  @@index([family])
  @@map("refresh_tokens")
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId     String?
  space       Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  timeSessions TimeSession[]
  title       String
  date        DateTime @db.Date
  completed   Boolean  @default(false)
  description String?
  hoursSpent  Float?
  statusId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, spaceId])
  @@index([milestoneId])
  @@map("tasks")
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum InboxStatus {
  PENDING
  PROCESSED
  DISMISSED
}

model TimeSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId     String?
  space       Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  note        String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, startedAt])
  @@map("time_sessions")
}

model InboxItem {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  status    InboxStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@map("inbox_items")
}

model Milestone {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId     String?
  space       Space?          @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      MilestoneStatus @default(PLANNED)
  targetDate  DateTime?       @db.Date
  order       Int             @default(0)
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([userId, spaceId])
  @@map("milestones")
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name      String
  color     String   @default("#6366f1")
  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, spaceId])
  @@map("folders")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title     String   @default("Untitled")
  content   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([folderId])
  @@index([userId, spaceId])
  @@map("notes")
}

model LinkCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name      String
  color     String   @default("#6366f1")
  links     Link[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, spaceId])
  @@map("link_categories")
}

model Link {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId     String?
  space       Space?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    LinkCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  url         String
  description String?
  username    String?
  password    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([userId, spaceId])
  @@map("links")
}

model Credential {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  service   String
  username  String
  password  String
  url       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, spaceId])
  @@map("credentials")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId     String?
  space       Space?          @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  type        TransactionType
  amount      Float
  category    String
  description String?
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, spaceId])
  @@map("transactions")
}

model Subscription {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId         String?
  space           Space?       @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name            String
  amount          Float
  billingCycle    BillingCycle
  nextBillingDate DateTime     @db.Date
  active          Boolean      @default(true)
  description     String?
  category        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([userId, spaceId])
  @@map("subscriptions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}
